# Built-in Android & Gradle ignores
*.iml
.gradle/
/local.properties
/.idea/
.DS_Store
/build/
/app/build/
captures/
.externalNativeBuild/
.cxx/
*.dex
*.class

# Memory dumps and logs
*.hprof
*.log

# Virtual Android TV artifacts
/.android/
/.kotlin/

# Signing credentials & keystores (never commit secrets)
keystore.properties
keystore/*.jks
*.jks
*.keystore

# Python cache
__pycache__/
*.pyc

# Output release directory (we keep docs and source code)
/app/build/outputs/

